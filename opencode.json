{
  "mcp": {
    "servers": {
      "firefox-devtools": {
        "type": "local",
        "command": [
          "npx",
          "@mozilla/firefox-devtools-mcp",
          "--tool-preset",
          "developer"
        ]
      },
      "cloudflare": {
        "type": "remote",
        "url": "https://mcp.cloudflare.com/mcp"
      }
    }
  }
}